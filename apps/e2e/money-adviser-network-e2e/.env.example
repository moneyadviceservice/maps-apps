# E2E-only environment overrides for Money Adviser Network.
#
# These values are loaded before the main app `.env.local` when running Playwright webServer.
# Keep only E2E-specific overrides here.

# Mock API - E2E testing, needs to match the port in run-e2e.ts
MOCK_API_PORT=9000

# Route app API calls to local mock API during E2E
APPOINTMENTS_API=http://127.0.0.1:${MOCK_API_PORT}/
