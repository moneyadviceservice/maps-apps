{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "outDir": "../../../dist/out-tsc",
    "types": ["playwright", "node"],
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "**/*.mjs",
    "playwright.config.ts",
    "e2e/**/*.spec.ts",
    "e2e/**/*.spec.js",
    "e2e/**/*.test.ts",
    "e2e/**/*.test.js",
    "e2e/**/*.d.ts"
  ],
  "exclude": [
    "cypress",
    "**/*.cy.ts",
    "**/*.cy.tsx",
    "**/*.cy.js",
    "**/*.cy.jsx"
  ]
}
