# Select one of: local, dev, test, preprod, prod
TARGET_ENV=

# Local, dev, and prod defaults are configured in playwright.config.ts.
# Override an origin here if needed; URLs should not include a route path.
# LOCAL_BASE_URL=
# DEV_BASE_URL=
# PROD_BASE_URL=

# Set these to the current deployment origins for your team.
TEST_BASE_URL=
PREPROD_BASE_URL=

# Required only for Netlify password-protected deploys; keep this value private.
HTTP_PASSWORD=
