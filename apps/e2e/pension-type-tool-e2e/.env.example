# Select one of: local, dev, test, preprod, prod
TARGET_ENV=

# Dev/prod defaults are configured in playwright.config.ts; override if needed.
# DEV_BASE_URL=
# PROD_BASE_URL=

# Supply the canonical test URL and the preprod deployment URL for your team.
TEST_BASE_URL=
PREPROD_BASE_URL=

# Required only for Netlify password-protected deploys; keep this value private.
HTTP_PASSWORD=
