# Select one of: local, dev, test, preprod, prod
TARGET_ENV=

# Local/dev/prod defaults are configured in playwright.config.ts.
# LOCAL_BASE_URL=
# DEV_BASE_URL=
# PROD_BASE_URL=

# Supply your team's test and preprod origins (no route paths).
TEST_BASE_URL=
PREPROD_BASE_URL=

# Optional one-off override of the selected environment.
# BASE_URL=

# Required only for password-protected deploys; keep this value private.
HTTP_PASSWORD=