{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "src",
    "allowJs": true,
    "outDir": "../../../dist/out-tsc",
    "types": ["playwright", "node"],
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@lib/*": ["lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.js"]
}
