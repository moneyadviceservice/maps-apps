APP_ROOT=/
HIDDEN_ROUTES=
NEXT_PUBLIC_ENVIRONMENT=development
ENVIRONMENT=development
NEXT_PUBLIC_DEV_FEEDBACK_SITE_ID=

## Cosmos
DB_CONNECTION_STRING=
DB_DATABASE_ID=
DB_CONTAINER_ID=

## Redis (listings cache)
REDIS_API_URL=
REDIS_API_KEY=

## Sessions
# iron-session passwords must be at least 32 characters
ACCOUNT_SESSION_SECRET=
SESSION_SECRET=

## Admin Entra ID
TENANT_SUBDOMAIN=
REDIRECT_URI=http://localhost:4313/api/auth/redirect
ENTRA_CLIENT_ID_SIGN_IN=
ENTRA_CLIENT_SECRET_SIGN_IN=
ENTRA_CLIENT_URL=
ADMIN_APP_ROLE=tid_admin

## FCA register
FCA_API_BASE_URL=https://register.fca.org.uk/services
FCA_API_KEY=
FCA_API_EMAIL=

## GOV.UK Notify
NOTIFY_API_KEY=
NOTIFY_TEMPLATE_REGISTER_SUCCESS=
NOTIFY_TEMPLATE_REGISTER_UNSUCCESSFUL=
NOTIFY_TEMPLATE_REGISTER_SAVE=
NOTIFY_TEMPLATE_REREGISTRATION=
NOTIFY_TEMPLATE_INVALID_FRN=
NOTIFY_TEMPLATE_FCA_VALIDATION_REPORT=
NOTIFY_ADMIN_EMAIL=

## Scheduled jobs
VALIDATE_FIRM_API_SECRET=

## Hosting (Netlify deploy only)
BASIC_AUTH_CREDENTIALS=

