# --- AEM (required for homepage, tags, and live research library) ---
AEM_HOST=
AEM_HOST_PUBLIC=
AEM_USERNAME=
AEM_PASSWORD=
AEM_USERAGENT=

# Stable cache namespace per deploy.
AEM_CACHE=

# --- Redis REST (research library slim docs + search index). TTL 1h. ---
# Set with Functions scope on Netlify.
REDIS_API_URL=
REDIS_API_KEY=

# --- Analytics / cookies ---
NEXT_PUBLIC_ADOBE_ANALYTICS_SCRIPT=
NEXT_PUBLIC_CIVIC_COOKIE_SCRIPT=
NEXT_PUBLIC_CIVIC_COOKIE_API_KEY=

# --- Local / CI only ---
# Log cache hits and slug counts (server console). Duplicate slugs always warn.
# EVIDENCE_HUB_CACHE_LOG=true

# Use fixtures/e2e for the documents list query (homepage/tags still hit AEM).
# Pipeline e2e sets this. Do not set it if you need real library data.
# CI=true
