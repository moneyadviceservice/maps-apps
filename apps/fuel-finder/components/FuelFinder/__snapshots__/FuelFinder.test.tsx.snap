          class="t-stations-information text-base text-gray-800 flex flex-col gap-4 pb-4 lg:pb-8 lg:gap-2"
        >
          <div
            class="flex flex-col gap-4 lg:gap-2 lg:py-4"
          >
            <h1
              class="text-blue-700 text-4xl font-bold md:text-6xl"
            >
              {a} stations found near your location for {b}
            </h1>
            <a
              class="inline-flex items-center gap-2 text-magenta-500 visited:text-purple-700 focus:text-gray-800 focus:bg-yellow-400 focus:shadow-link-focus focus-within:outline-none underline hover:no-underline focus:no-underline cursor-pointer active:text-gray-800 active:underline active:bg-transparent active:shadow-none"
              href="/en"
            >
              Change location
            </a>
          </div>
          <div>
            Data last retrieved
             
            4/6/2025 12:00
          </div>
          <div>
            If you spot a price at the pump that doesn't match these results, you can 
            <a
              class="inline items-center gap-2 text-magenta-500 visited:text-purple-700 focus:text-gray-800 focus:bg-yellow-400 focus:shadow-link-focus focus-within:outline-none underline hover:no-underline focus:no-underline cursor-pointer active:text-gray-800 active:underline active:bg-transparent active:shadow-none"
              href="https://www.gov.uk/guidance/report-an-error-in-fuel-prices-or-forecourt-details"
              rel="noopener noreferrer"
              target="_blank"
            >
              report the error
              <span
                class="sr-only"
              >
                 (opens in a new tab)
              </span>
            </a>
             
            on GOV.UK
          </div>
        </div>
